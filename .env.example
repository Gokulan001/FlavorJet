# Copy to .env.local and fill in values. See README.md "Local Setup" for
# which routes/features each variable gates.

# AI Provider (google | openai | anthropic)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# RAG (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Supabase — bare project URL, e.g. https://xxx.supabase.co (no /rest/v1/ suffix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Voice (ElevenLabs) — server-side only, proxied via /api/tts and /api/stt
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Weather (also requires browser location permission on /order-ai)
OPENWEATHERMAP_API_KEY=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Interview access gate
ACCESS_GATE_SECRET=
ACCESS_GATE_ADMIN_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
